{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "839496", "background": "002b36" },
    { "token": "comment", "foreground": "586e75", "fontStyle": "italic" },
    { "token": "string", "foreground": "2aa198" },
    { "token": "string.escape", "foreground": "dc322f" },
    { "token": "keyword", "foreground": "859900" },
    { "token": "keyword.control", "foreground": "859900" },
    { "token": "keyword.operator", "foreground": "839496" },
    { "token": "storage", "foreground": "859900" },
    { "token": "storage.type", "foreground": "268bd2" },
    { "token": "constant", "foreground": "2aa198" },
    { "token": "constant.numeric", "foreground": "2aa198" },
    { "token": "number", "foreground": "2aa198" },
    { "token": "constant.language", "foreground": "cb4b16" },
    { "token": "variable", "foreground": "268bd2" },
    { "token": "variable.other", "foreground": "839496" },
    { "token": "variable.parameter", "foreground": "268bd2" },
    { "token": "entity.name.function", "foreground": "268bd2" },
    { "token": "entity.name.class", "foreground": "cb4b16" },
    { "token": "entity.name.type", "foreground": "cb4b16" },
    { "token": "entity.name.tag", "foreground": "268bd2" },
    { "token": "entity.other.attribute-name", "foreground": "657b83" },
    { "token": "support.function", "foreground": "268bd2" },
    { "token": "support.class", "foreground": "cb4b16" },
    { "token": "support.type", "foreground": "859900" },
    { "token": "type", "foreground": "859900" },
    { "token": "identifier", "foreground": "839496" },
    { "token": "delimiter", "foreground": "839496" },
    { "token": "operator", "foreground": "839496" },
    { "token": "tag", "foreground": "268bd2" },
    { "token": "attribute.name", "foreground": "657b83" },
    { "token": "attribute.value", "foreground": "2aa198" },
    { "token": "regexp", "foreground": "dc322f" },
    { "token": "invalid", "foreground": "93a1a1", "background": "dc322f" }
  ],
  "colors": {
    "editor.foreground": "#839496",
    "editor.background": "#002b36",
    "editor.selectionBackground": "#073642",
    "editor.inactiveSelectionBackground": "#07364266",
    "editor.lineHighlightBackground": "#07364299",
    "editorCursor.foreground": "#839496",
    "editorWhitespace.foreground": "#073642",
    "editorIndentGuide.background": "#073642",
    "editorIndentGuide.activeBackground": "#586e75",
    "editorLineNumber.foreground": "#586e75",
    "editorLineNumber.activeForeground": "#839496",
    "editorBracketMatch.background": "#073642",
    "editorBracketMatch.border": "#268bd2",
    "editor.findMatchBackground": "#2aa19844",
    "editor.findMatchHighlightBackground": "#2aa19822",
    "editor.wordHighlightBackground": "#268bd233",
    "editorGutter.background": "#002b36",
    "editorGutter.modifiedBackground": "#b58900",
    "editorGutter.addedBackground": "#859900",
    "editorGutter.deletedBackground": "#dc322f",
    "scrollbarSlider.background": "#07364266",
    "scrollbarSlider.hoverBackground": "#07364299",
    "editorHoverWidget.background": "#073642",
    "editorHoverWidget.border": "#586e75",
    "editorWidget.background": "#073642",
    "editorWidget.border": "#586e75",
    "input.background": "#002b36",
    "input.border": "#586e75",
    "input.foreground": "#839496",
    "dropdown.background": "#073642",
    "dropdown.border": "#586e75",
    "dropdown.foreground": "#839496"
  }
