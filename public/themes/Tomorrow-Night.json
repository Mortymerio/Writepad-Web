  "colors": {
    "editor.foreground": "#c5c8c6",
    "editor.background": "#1d1f21",
    "editor.selectionBackground": "#373b41",
    "editor.inactiveSelectionBackground": "#373b4166",
    "editor.lineHighlightBackground": "#282a2e",
    "editorCursor.foreground": "#aeafad",
    "editorWhitespace.foreground": "#373b4166",
    "editorIndentGuide.background": "#373b41",
    "editorIndentGuide.activeBackground": "#969896",
    "editorLineNumber.foreground": "#969896",
    "editorLineNumber.activeForeground": "#c5c8c6",
    "editorBracketMatch.background": "#373b41",
    "editorBracketMatch.border": "#81a2be",
    "editor.findMatchBackground": "#b5bd6844",
    "editor.findMatchHighlightBackground": "#b5bd6822",
    "editor.wordHighlightBackground": "#81a2be33",
    "editorGutter.background": "#1d1f21",
    "editorGutter.modifiedBackground": "#f0c674",
    "editorGutter.addedBackground": "#b5bd68",
    "editorGutter.deletedBackground": "#cc6666",
    "scrollbarSlider.background": "#373b4166",
    "scrollbarSlider.hoverBackground": "#373b4199",
    "editorHoverWidget.background": "#282a2e",
    "editorHoverWidget.border": "#373b41",
    "editorWidget.background": "#282a2e",
    "editorWidget.border": "#373b41",
    "input.background": "#1d1f21",
    "input.border": "#373b41",
    "input.foreground": "#c5c8c6",
    "dropdown.background": "#282a2e",
    "dropdown.border": "#373b41",
    "dropdown.foreground": "#c5c8c6"
