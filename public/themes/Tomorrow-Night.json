{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "c5c8c6", "background": "1d1f21" },
    { "token": "comment", "foreground": "969896", "fontStyle": "italic" },
    { "token": "string", "foreground": "b5bd68" },
    { "token": "string.escape", "foreground": "de935f" },
    { "token": "keyword", "foreground": "b294bb" },
    { "token": "keyword.control", "foreground": "b294bb" },
    { "token": "keyword.operator", "foreground": "c5c8c6" },
    { "token": "storage", "foreground": "b294bb" },
    { "token": "storage.type", "foreground": "81a2be" },
    { "token": "constant", "foreground": "de935f" },
    { "token": "constant.numeric", "foreground": "de935f" },
    { "token": "number", "foreground": "de935f" },
    { "token": "constant.language", "foreground": "de935f" },
    { "token": "variable", "foreground": "cc6666" },
    { "token": "variable.other", "foreground": "c5c8c6" },
    { "token": "variable.parameter", "foreground": "cc6666" },
    { "token": "entity.name.function", "foreground": "81a2be" },
    { "token": "entity.name.class", "foreground": "f0c674" },
    { "token": "entity.name.type", "foreground": "f0c674" },
    { "token": "entity.name.tag", "foreground": "cc6666" },
    { "token": "entity.other.attribute-name", "foreground": "de935f" },
    { "token": "entity.other.inherited-class", "foreground": "f0c674" },
    { "token": "support.function", "foreground": "8abeb7" },
    { "token": "support.class", "foreground": "f0c674" },
    { "token": "support.type", "foreground": "8abeb7" },
    { "token": "support.constant", "foreground": "8abeb7" },
    { "token": "type", "foreground": "f0c674" },
    { "token": "identifier", "foreground": "c5c8c6" },
    { "token": "delimiter", "foreground": "c5c8c6" },
    { "token": "operator", "foreground": "c5c8c6" },
    { "token": "tag", "foreground": "cc6666" },
    { "token": "attribute.name", "foreground": "de935f" },
    { "token": "attribute.value", "foreground": "b5bd68" },
    { "token": "annotation", "foreground": "f0c674" },
    { "token": "regexp", "foreground": "8abeb7" },
    { "token": "invalid", "foreground": "c5c8c6", "background": "cc6666" }
