{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "b9d1f4", "background": "1B1D2A" },
    { "token": "comment", "foreground": "60607a", "fontStyle": "italic" },
    { "token": "string", "foreground": "f5c791" },
    { "token": "string.escape", "foreground": "fb4934" },
    { "token": "keyword", "foreground": "e0af68" },
    { "token": "keyword.control", "foreground": "e0af68" },
    { "token": "keyword.operator", "foreground": "89ddff" },
    { "token": "storage", "foreground": "e0af68" },
    { "token": "storage.type", "foreground": "bb9af7" },
    { "token": "constant", "foreground": "ff9e64" },
    { "token": "constant.numeric", "foreground": "ff9e64" },
    { "token": "number", "foreground": "ff9e64" },
    { "token": "constant.language", "foreground": "ff9e64" },
    { "token": "variable", "foreground": "c0caf5" },
    { "token": "variable.other", "foreground": "c0caf5" },
    { "token": "variable.parameter", "foreground": "e0af68" },
    { "token": "entity.name.function", "foreground": "7aa2f7" },
    { "token": "entity.name.class", "foreground": "c0caf5" },
    { "token": "entity.name.type", "foreground": "bb9af7" },
    { "token": "entity.name.tag", "foreground": "f7768e" },
    { "token": "entity.other.attribute-name", "foreground": "9ece6a" },
    { "token": "support.function", "foreground": "7aa2f7" },
    { "token": "support.class", "foreground": "bb9af7" },
    { "token": "support.type", "foreground": "2ac3de" },
    { "token": "type", "foreground": "bb9af7" },
    { "token": "identifier", "foreground": "c0caf5" },
    { "token": "delimiter", "foreground": "c0caf5" },
    { "token": "delimiter.bracket", "foreground": "89ddff" },
    { "token": "operator", "foreground": "89ddff" },
    { "token": "tag", "foreground": "f7768e" },
    { "token": "attribute.name", "foreground": "9ece6a" },
    { "token": "attribute.value", "foreground": "f5c791" },
    { "token": "annotation", "foreground": "7aa2f7" },
    { "token": "regexp", "foreground": "2ac3de" },
    { "token": "invalid", "foreground": "c0caf5", "background": "f7768e" }
  ],
  "colors": {
    "editor.foreground": "#c0caf5",
    "editor.background": "#1a1b2e",
    "editor.selectionBackground": "#283457",
    "editor.inactiveSelectionBackground": "#28345766",
    "editor.lineHighlightBackground": "#1f2335",
    "editorCursor.foreground": "#c0caf5",
    "editorWhitespace.foreground": "#3b4261",
    "editorIndentGuide.background": "#29355a",
    "editorIndentGuide.activeBackground": "#3d59a1",
    "editorLineNumber.foreground": "#3b4261",
    "editorLineNumber.activeForeground": "#737aa2",
    "editorBracketMatch.background": "#343b58",
    "editorBracketMatch.border": "#7aa2f7",
    "editor.findMatchBackground": "#3d59a1aa",
    "editor.findMatchHighlightBackground": "#3d59a166",
    "editor.wordHighlightBackground": "#7aa2f733",
    "editorGutter.background": "#1a1b2e",
    "editorGutter.modifiedBackground": "#e0af68",
    "editorGutter.addedBackground": "#9ece6a",
    "editorGutter.deletedBackground": "#f7768e",
    "scrollbarSlider.background": "#29355a66",
    "scrollbarSlider.hoverBackground": "#29355a99",
    "editorHoverWidget.background": "#1f2335",
    "editorHoverWidget.border": "#29355a",
    "editorWidget.background": "#1f2335",
    "editorWidget.border": "#29355a",
    "input.background": "#1a1b2e",
    "input.border": "#29355a",
