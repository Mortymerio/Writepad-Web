{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "d6deeb", "background": "011627" },
    { "token": "comment", "foreground": "637777", "fontStyle": "italic" },
    { "token": "comment.doc", "foreground": "637777", "fontStyle": "italic" },
    { "token": "string", "foreground": "addb67" },
    { "token": "string.escape", "foreground": "ecc48d" },
    { "token": "keyword", "foreground": "c792ea" },
    { "token": "keyword.control", "foreground": "c792ea" },
    { "token": "keyword.operator", "foreground": "7fdbca" },
    { "token": "storage", "foreground": "c792ea" },
    { "token": "storage.type", "foreground": "c792ea" },
    { "token": "constant", "foreground": "ff5874" },
    { "token": "constant.numeric", "foreground": "f78c6c" },
    { "token": "number", "foreground": "f78c6c" },
    { "token": "constant.language", "foreground": "ff5874" },
    { "token": "variable", "foreground": "d6deeb" },
    { "token": "variable.other", "foreground": "d6deeb" },
    { "token": "variable.parameter", "foreground": "d6deeb", "fontStyle": "italic" },
    { "token": "entity.name.function", "foreground": "82aaff" },
    { "token": "entity.name.class", "foreground": "ffcb8b" },
    { "token": "entity.name.type", "foreground": "ffcb8b" },
    { "token": "entity.name.tag", "foreground": "7fdbca" },
    { "token": "entity.other.attribute-name", "foreground": "7fdbca" },
    { "token": "support.function", "foreground": "82aaff" },
    { "token": "support.class", "foreground": "ffcb8b" },
    { "token": "support.type", "foreground": "7fdbca" },
    { "token": "type", "foreground": "ffcb8b" },
    { "token": "identifier", "foreground": "d6deeb" },
    { "token": "delimiter", "foreground": "d6deeb" },
    { "token": "delimiter.bracket", "foreground": "d6deeb" },
    { "token": "operator", "foreground": "7fdbca" },
    { "token": "tag", "foreground": "7fdbca" },
    { "token": "attribute.name", "foreground": "7fdbca" },
    { "token": "attribute.value", "foreground": "addb67" },
    { "token": "annotation", "foreground": "82aaff" },
    { "token": "regexp", "foreground": "5ca7e4" },
    { "token": "invalid", "foreground": "d6deeb", "background": "ff5874" }
  ],
  "colors": {
    "editor.foreground": "#d6deeb",
    "editor.background": "#011627",
    "editor.selectionBackground": "#1d3b53",
    "editor.inactiveSelectionBackground": "#1d3b5366",
    "editor.lineHighlightBackground": "#010e1a",
    "editorCursor.foreground": "#80a4c2",
    "editorWhitespace.foreground": "#2d3f5288",
    "editorIndentGuide.background": "#1e3a51",
    "editorIndentGuide.activeBackground": "#4a6a84",
    "editorLineNumber.foreground": "#4b6479",
    "editorLineNumber.activeForeground": "#c5e4fd",
    "editorBracketMatch.background": "#1d3b53",
    "editorBracketMatch.border": "#7fdbca",
    "editor.findMatchBackground": "#addb6744",
    "editor.findMatchHighlightBackground": "#addb6722",
    "editor.wordHighlightBackground": "#82aaff33",
    "editorGutter.background": "#011627",
    "editorGutter.modifiedBackground": "#ecc48d",
    "editorGutter.addedBackground": "#addb67",
    "editorGutter.deletedBackground": "#ff5874",
    "scrollbarSlider.background": "#1d3b5366",
    "scrollbarSlider.hoverBackground": "#1d3b5399",
    "editorHoverWidget.background": "#011627",
    "editorHoverWidget.border": "#1d3b53",
    "editorWidget.background": "#010e1a",
    "editorWidget.border": "#1d3b53",
    "input.background": "#011627",
    "input.border": "#1d3b53",
    "input.foreground": "#d6deeb",
    "dropdown.background": "#010e1a",
    "dropdown.border": "#1d3b53",
    "dropdown.foreground": "#d6deeb"
  }
}